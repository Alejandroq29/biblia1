// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
//Conexiones a base de datos
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Modulo de las organizaciones
model Organization {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(150)
  legalName         String?   @map("legal_name") @db.VarChar(200)
  taxIdentification String?   @map("tax_identification") @db.VarChar(30)
  email             String?   @db.VarChar(180)
  phone             String?   @db.VarChar(20)
  domain            String?   @db.VarChar(255)
  status            String    @db.VarChar(30)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  venues    Venue[]
  roles     Role[]
  userRoles UserRole[]

  @@index([name])
  @@map("organizations")
}

model Venue {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  address        String?   @db.Text
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(180)
  status         String    @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("venues")
}

//Modulo de Usuarios
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(180)
  username     String?  @unique @db.VarChar(100)
  passwordHash String?  @map("password_hash") @db.Text
  status       String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profile      UserProfile?
  authAccounts AuthAccount[]
  sessions     UserSession[]
  userRoles    UserRole[]
  bibliaAttempts BibliaGameAttempt[]
  bibliaProgress BibliaProgress[]
  bibliaFavorites BibliaFavorite[]
  bibliaReadingPlans BibliaReadingPlan[]

  @@map("users")
}

model UserProfile {
  userId         String   @id @map("user_id") @db.Uuid
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  identification String?  @db.VarChar(30)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AuthAccount {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  provider          String @db.VarChar(50)
  providerAccountId String @map("provider_account_id") @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model UserSession {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Los tokens OAuth (access, refresh, id) viven aquí y NO en la cookie:
  // los tres juntos superan el límite de 4096 bytes que impone el navegador.
  // Se guardan sellados con @hapi/iron, para que un volcado de la base no los exponga.
  sealedTokens String @map("sealed_tokens") @db.Text

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

//Modulo de roles y permisos
model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  code           String    @db.VarChar(100)
  name           String    @db.VarChar(150)
  description    String?   @db.Text
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String    @db.VarChar(100)
  action      String    @db.VarChar(100)
  code        String    @unique @db.VarChar(200)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]
  menus MenuPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String  @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  granted      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  roleId         String  @map("role_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  venueId        String? @map("venue_id") @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId, venueId])
  @@map("user_roles")
}

//Modulo de menus de acceso
model Menu {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  code     String  @unique @db.VarChar(100)
  name     String  @db.VarChar(150)
  route    String? @db.VarChar(255)

  parent      Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Menu[]           @relation("MenuHierarchy")
  permissions MenuPermission[]

  @@map("menus")
}

model MenuPermission {
  menuId       String @map("menu_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([menuId, permissionId])
  @@map("menu_permissions")
}

enum BibliaStatus {
  ACTIVE
  INACTIVE
}

model BibliaStory {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String      @db.VarChar(180)
  slug        String      @unique @db.VarChar(200)
  summary     String?     @db.Text
  content     String      @db.Text
  minAge      Int         @map("min_age")
  maxAge      Int         @map("max_age")
  status      BibliaStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  levels      BibliaStoryLevel[]
  games       BibliaGame[]
  attempts    BibliaGameAttempt[]
  progress    BibliaProgress[]

  @@index([status, deletedAt])
  @@index([minAge, maxAge])
  @@map("biblia_stories")
}

model BibliaLevel {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique @db.VarChar(80)
  name        String      @db.VarChar(120)
  description String?     @db.Text
  sortOrder   Int         @map("sort_order")
  status      BibliaStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  stories     BibliaStoryLevel[]
  games       BibliaGame[]
  attempts    BibliaGameAttempt[]
  progress    BibliaProgress[]

  @@index([status, deletedAt])
  @@index([sortOrder])
  @@map("biblia_levels")
}

model BibliaStoryLevel {
  storyId     String      @map("story_id") @db.Uuid
  levelId     String      @map("level_id") @db.Uuid

  story       BibliaStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  level       BibliaLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([storyId, levelId])
  @@map("biblia_story_levels")
}

model BibliaGame {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storyId      String      @map("story_id") @db.Uuid
  levelId      String      @map("level_id") @db.Uuid
  title        String      @db.VarChar(180)
  description  String?     @db.Text
  instructions String?     @db.Text
  gameType     String      @map("game_type") @db.VarChar(50)
  maxScore     Int         @default(100) @map("max_score")
  status       BibliaStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz

  story        BibliaStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  level        BibliaLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  questions    BibliaGameQuestion[]
  attempts     BibliaGameAttempt[]

  @@index([storyId, levelId])
  @@index([status, deletedAt])
  @@map("biblia_games")
}

model BibliaGameQuestion {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId        String     @map("game_id") @db.Uuid
  questionOrder Int        @map("question_order")
  prompt        String     @db.Text
  options       Json?
  correctAnswer Json       @map("correct_answer")
  points        Int        @default(1)

  game          BibliaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, questionOrder])
  @@map("biblia_game_questions")
}

model BibliaGameAttempt {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  gameId         String      @map("game_id") @db.Uuid
  storyId        String      @map("story_id") @db.Uuid
  levelId        String      @map("level_id") @db.Uuid
  score          Int
  maxScore       Int         @map("max_score")
  answers        Json?
  completedAt    DateTime    @map("completed_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           BibliaGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  story          BibliaStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  level          BibliaLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@index([userId, storyId, levelId])
  @@index([gameId, createdAt])
  @@map("biblia_game_attempts")
}

model BibliaProgress {
  userId          String      @map("user_id") @db.Uuid
  storyId         String      @map("story_id") @db.Uuid
  levelId         String      @map("level_id") @db.Uuid
  bestScore       Int         @default(0) @map("best_score")
  attemptsCount   Int         @default(0) @map("attempts_count")
  completed       Boolean     @default(false)
  lastPlayedAt    DateTime?   @map("last_played_at") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  story           BibliaStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  level           BibliaLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@id([userId, storyId, levelId])
  @@index([userId, completed])
  @@map("biblia_progress")
}

// Recursos bíblicos estructurados
model BibliaBook {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique @db.VarChar(80)
  title     String      @db.VarChar(250)
  testament String?     @db.VarChar(20)
  summary   String?     @db.Text
  status    BibliaStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz

  chapters  BibliaChapter[]

  @@index([code])
  @@index([status, deletedAt])
  @@map("biblia_books")
}

model BibliaChapter {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId    String      @map("book_id") @db.Uuid
  number    Int
  title     String?     @db.VarChar(250)
  summary   String?     @db.Text
  status    BibliaStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz

  book      BibliaBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  verses    BibliaVerse[]

  @@unique([bookId, number])
  @@index([bookId])
  @@index([status, deletedAt])
  @@map("biblia_chapters")
}

model BibliaVerse {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId  String      @map("chapter_id") @db.Uuid
  number     Int
  text       String      @db.Text
  notes      String?     @db.Text
  status     BibliaStatus @default(ACTIVE)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz

  chapter    BibliaChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, number])
  @@index([chapterId])
  @@index([status, deletedAt])
  @@map("biblia_verses")
}

model BibliaFavorite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  resource   String    @db.VarChar(100)
  resourceId String    @map("resource_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource, resourceId])
  @@map("biblia_favorites")
}

model BibliaReadingPlan {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(180)
  items     Json
  startDate DateTime?
  endDate   DateTime?
  status    BibliaStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("biblia_reading_plans")
}
